pico-8 cartridge // http://www.pico-8.com
version 8
__lua__
-- clon de tetris (2019)
-- electronica villacorta
function _init()
	arena={}
	tetris={}
	sig={}
	pieza={}
	bloque={}
	bloque[1]="x1xx111xxxxxxxxx"--t
	bloque[2]="xxxx1111xxxxxxxx"--i
	bloque[3]="xx1x111xxxxxxxxx"--l
	bloque[4]="1xxx111xxxxxxxxx"--j
	bloque[5]="11xxx11xxxxxxxxx"--z
	bloque[6]="x11x11xxxxxxxxxx"--s
	bloque[7]="11xx11xxxxxxxxxx"--o
	anim_tetris=false
	anim_counter=0
	arena.tip=17
	sig.tip=1
	sig.col=1
	dy=0.2
	lineas=0
	pause=false
	pause_time=0
	modo="splash"
	offset=0.06
	duracion_shake=0
	shake=false
	puntos=0
	nivel=0
	pieza.col=0
	pieza.tip=1
	music(0)
 reset()
 nuevo_bloque()
end

function reset()
	cls()
	pieza.dy=dy
	pieza.h=6
	lineas_cnt=0
	rapido=false
	pieza.y=0
	gameover=false
	resetear_arena()
	fxcaer=true
end

function _update()
	if shake then screen_shake() end 
	if modo=="gameover" then
		teclado()
	elseif modo=="game" then
		teclado() 
		cae_pieza()
		buscar_tetris()
		revisa_nivel()	
	elseif modo=="splash" then
		teclado()
	elseif modo=="nuevonivel" then
		if pause==false then
			modo="game"
		else
			pause_time+=1
			if pause_time>=105 then pause=false pause_time=0 end
		end
	end
end

function cae_pieza()
 if rapido then 
 	pieza.dy=2.5
 else 
 	pieza.dy=dy
 end
	if colision("do") then	
		fusionar() 
		fxcaer=true
	else 
		pieza.y+=pieza.dy 
	end
end

function _draw()
	cls()
	if modo=="game" then
		draw_blocks()
	elseif modo=="splash" then
		draw_splash()
	elseif modo=="nuevonivel" then
		draw_nuevonivel()
	elseif modo=="gameover" then
	 draw_gameover()
	end
	if debug then
 	print (debug,120,120,7)
	end
draw_tetris(2)
end

function nuevo_bloque(c)
	local t,s
	rapido=false
	pieza.x=pieza.h*4
	pieza.tip=sig.tip
	sig.tip=flr(rnd(7)+1)
	pieza.col=sig.col
	sig.col=flr(rnd(16)+1)
	for i=1,16 do
		pieza[i]="x"
		sig[i]="x"
		t=sub(bloque[pieza.tip],i,i)
		s=sub(bloque[sig.tip],i,i)
		if t!="x" then	t=pieza.col+0	end
  if s!="x" then	s=sig.col+0 end
		pieza[i]=t
		sig[i]=s
	end
end

function draw_blocks()
	draw_arena()
	draw_falling()
	draw_next()
	draw_fixed()
	draw_tetris()
end

function draw_falling()
 -- falling block
 if rapido then draw_sparkles() end
	i=0
	for y=1,4 do
		for x=1,4 do
		i+=1
				if pieza[i]!="x" then
					spr(pieza.col,pieza.x+(x*pieza.h),pieza.y+(y*pieza.h)) 
			 end
			end
		end	
end

function draw_next()
	-- next block
	i=0
	for y=1,4 do
		for x=1,4 do
		i+=1
		t=90  l=85
		if sig.tip==2 then t=87 l=82 end
		if sig.tip==7 then l=88 end
				if sig[i]!="x" then
					spr(sig.col,l+(x*pieza.h),t+(y*pieza.h)) 
				end
			end
		end
end

function draw_fixed()
	-- fixed block
	i=0
	for y=1,22 do
		for x=0,11 do
		i+=1
				if arena[i]!="x" then
					a=arena[i]
					spr(a,x*pieza.h,(y*pieza.h))
				end
			end
		end
end

function draw_arena()
	w=pieza.h*11
	h=pieza.h*21
	for my=0,15 do
		for mx=0,15 do
			spr(19,mx*8,my*8) 
		end
	end
	

	map (0,0)
	for y=0,20 do
		for x=1,10 do
  	spr(arena.tip,x*pieza.h-1,y*pieza.h-1) 
		end
	end	
	
	rect(5,2,w,h,7)
	rect(4,1,w+1,h+1,6)
	rect(3,0,w+2,h+2,5)
	print ("puntos",88,10,0)
	o="000000"..puntos
	l=#o-6
	o=sub(o,1+l,6+l)
	--int ("000000",89,20,11)
	print (o,89,20,10)
	print ("nivel",91,34,0)
	o="000"..nivel
	l=#o-3
	o=sub(o,1+l,3+l)
	print (o,94,44,10)
	print ("lineas",88,58,0)
	o="000000"..lineas
	l=#o-6
	o=sub(o,1+l,6+l)
	print (o,89,68,10)	
	print ("siguiente",82,82,0)
end

function colision(p)
local xx,yy,py,px
	px=1 py=0
 if p=="do" then py=1 end
	--if p=="le" then px=1 py=0 end
	--if p=="ri" then px=1 py=0 end
	xx=flr((pieza.x/pieza.h))+px
	yy=flr((pieza.y/pieza.h))+py
	i=xx+(yy*12)
	for y=0,3 do
		for x=1,4 do
			if pieza[x+(y*4)]!="x" then
				if arena[i+x]!="x" then
 					return true
					end
			end
		end
		i=i+12
	end
end

function fusionar()
local xx,yy,i,x,y
	rapido=false
	xx=flr((pieza.x/pieza.h)+1)
	yy=flr((pieza.y/pieza.h)+1)
	i=xx+(yy*12)-12
	for y=0,3 do
		for x=1,4 do
			if pieza[x+(y*4)]!="x" then
				arena[i+x]=pieza[x+(y*4)]
			end
		end
		i=i+12	
	end
	pieza.y=0
 sfx(0)
 shake=true

	if yy>=2 then
		modo="game"
		nuevo_bloque() 
	else
		sfx(4)
		modo="gameover"
	end
end

function revisa_nivel()
--revisa nivel
	if lineas_cnt>=30 then
		modo="nuevonivel"
		lineas_cnt_cnt=0
 	music(1) 
		reset()
		if nivel==999 then nivel=0 end
		if arena.tip==17 then 
			arena.tip=18
		else
			arena.tip=17
		end
 	nivel+=1
		dy+=0.1
		pieza.dy=dy
	else
	end
end

function teclado()
	if modo=="game" then
		if btnp(1) then
			sfx(2)
			pieza.x+=pieza.h
 		if colision("ri") then	pieza.x-=pieza.h end	
 	end 
 	if btnp(0) then
			sfx(2)
			pieza.x-=pieza.h
			if colision("le") then	pieza.x+=pieza.h end	 end
 	if btnp(2) then
 		if not colision("le") then girar() end
		end
		if btn(3) then
  	-- caer
  	if fxcaer then 
				sfx(14)
				fxcaer=false
			end
 		rapido=true
 	end
 end
 if btnp(5) then
 	if modo=="gameover" then
 	 _init()
 	elseif modo=="splash" then
  	modo="nuevonivel"
  	pause=true 
  	reset()
 		nuevo_bloque()
  	music(1)
 	end
	end
end

function girar()	
	sfx(1)
	if pieza.tip!=7 then
		temp={}
		for i=1,16 do
			add(temp,pieza[i])
		end
		-- transpose
		temp[1]=pieza[9]
		temp[2]=pieza[5]
		temp[3]=pieza[1]
		temp[4]=pieza[13]
		temp[5]=pieza[10]
		temp[6]=pieza[6]
		temp[7]=pieza[2]
		temp[8]=pieza[14]
		temp[9]=pieza[11]
		temp[10]=pieza[7]
		temp[11]=pieza[3]
		temp[12]=pieza[15]
		temp[13]=pieza[12]
		temp[14]=pieza[8]
		temp[15]=pieza[4]
		temp[16]=pieza[16]
		c=false px=1 py=0 
		xx=flr((pieza.x/pieza.h))+px
		yy=flr((pieza.y/pieza.h))+py
		i=xx+(yy*12)
		for y=0,3 do
			for x=1,4 do
				if temp[x+(y*4)]!="x" then
					if arena[i+x]!="x" then
						c=true
					end
				end
			end
			i=i+12
		end
		if not c then
			for i=1,16 do
				pieza[i]=temp[i]
			end
		end
	end
end

function buscar_tetris()
 tetris={}
 d=0 i=0 f=0
	for y=1,4 do add(tetris,0) end
 for y=1,20 do
		l=0
		for x=1,12 do
			i+=1
			if arena[i]!="x" then l+=1 end
			if l==12 then
			anim_tetris=true
				l=0 f+=1 tetris[f]=i
				for xx=1,12 do arena[i+1-xx]="-" end
			end
		end 
 end
end

function borrar_tetris() 
 local temp={}
 for xx=1,252 do add(temp,"x") end
 for xx=240,252 do temp[xx]=0 end
 for xx=1,252,12 do
	 temp[xx]=0
	 temp[xx-1]=0
 end
 
 for d=1,4 do
  i=252
  if tetris[d]>=0 then
	  for xx=252,tetris[d]+1,-1 do
	 	 temp[i]=arena[xx] i-=1
 	 end
			for xx=tetris[d]-(12),1,-1 do
				temp[i]=arena[xx]	i-=1
			end
			for i=1,252 do arena[i]=temp[i] end
		end
		if f>=1 then pause=true end
		if f==1 then puntos+=40*(nivel+1) sfx(5)
			elseif f==2 then puntos+=100*(nivel+1) sfx(5)
			elseif f==3 then puntos+=300*(nivel+1) sfx(5) 
			elseif f==4 then puntos+=1200*(nivel+1) sfx(6) 
		end
	end
	lineas+=f
	lineas_cnt+=f
end

function draw_splash()
	map(16,0)
	print( "electronica villacorta",18,60,6)
	print( "2019",55,68,6)
	print("presione —",40,102,7)
end

function screen_shake()
	local fade=0.95
	local offset_x=16-rnd(32)
	local offset_y=16-rnd(32)
	offset_x*=offset
	offset_y*=offset	
	camera(offset_x,offset_y)
	offset*=fade
	if offset<0.05 then
		offset=0
	end
	duracion_shake+=1
	if duracion_shake>=5 then 
		shake=false 
		offset=0.06
		duracion_shake=0 
		camera(0,0) 
	end
end

function draw_nuevonivel()
	draw_blocks()
 draw_blocks()
	palt(13,true)
	palt(0,false)
	map(36,0,24,20,4,4)
	rectfill(6,50,65,66,0)	
	rectfill(6,68,65,70,0)	
	rectfill(6,72,65,73,0)	
	rectfill(6,76,65,76,0)	
	pal()
	print("nivel: "..nivel,20,56,10)
end

function resetear_arena()
	for i=1,252 do
		add(arena,"x")
	end
	for i=240,252 do
		arena[i]=0
	end
	for i=1,252,12 do
		arena[i]=0
		arena[i-1]=0
	end
	for i=1,16 do
		add(pieza,"x")
		add(sig,"x")
	end
end

function draw_gameover()
	draw_blocks()
	palt(13,true)
	palt(0,false)
	map(32,0,20,20,4,4)
	rectfill(6,50,65,66,0)	
	rectfill(6,68,65,70,0)	
	rectfill(6,72,65,73,0)	
	rectfill(6,76,65,76,0)	
	pal()
	print("game over",20,56,10)
end

function draw_tetris()
if anim_tetris then
if anim_counter<5 then a=25 end
if anim_counter>5 then a=26 end
anim_counter+=1
if anim_counter>=10 then
 	borrar_tetris()
 	anim_tetris =false
 	anim_counter=0
 end
-- exploted block
	i=0
	for y=1,22 do
		for x=0,11 do
				i+=1
				if arena[i]=="-" then
				if x!=0 and x!=11 then
						draw_explotion(y)
					--spr(a,x*pieza.h,(y*pieza.h))
				end
			 end
			end
		end

	end
end

function draw_explotion(ay)
	for a=6,60,6 do
		for i=1,3 do
			x=rnd(4)
			y=rnd(4)
			z=rnd(2)
			circfill(a+x,(ay*pieza.h)+y,z,10-i)
		end
	end
end

function draw_sparkles()
		for i=1,3 do
			x=rnd(7)
			y=rnd(18)
			z=rnd(2)
			circfill(pieza.x+x+10,pieza.y-y+8,z,7)
		end
end
